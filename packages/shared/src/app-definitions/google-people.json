{
  "schemaVersion": 1,
  "slug": "google-people",
  "name": "Google People",
  "description": "使用 Google People API 搜索联系人和目录个人资料。",
  "categories": [
    "communication",
    "productivity"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/google-people.svg"
  },
  "urlPatterns": [
    "https://people.googleapis.com/*"
  ],
  "docsUrl": "https://developers.google.com/people/api/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "people.read",
      "capabilityProfile": {
        "key": "read",
        "label": "读取联系人",
        "description": "搜索联系人、组织目录成员和个人资料。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 访问 Google People。",
      "defaults": {
        "serverUrl": "https://people.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/directory.readonly",
          "https://www.googleapis.com/auth/userinfo.profile",
          "https://www.googleapis.com/auth/contacts.readonly"
        ]
      },
      "guidanceMd": "连接 Google People，以搜索联系人和目录个人资料。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "读取联系人",
        "description": "搜索联系人、组织目录成员和个人资料。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端访问 Google People。",
      "defaults": {
        "serverUrl": "https://people.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/directory.readonly",
          "https://www.googleapis.com/auth/userinfo.profile",
          "https://www.googleapis.com/auth/contacts.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 People API 和 People MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "能否搜索组织目录取决于你的 Workspace 账户。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    }
  ]
}
