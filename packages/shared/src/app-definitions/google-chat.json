{
  "schemaVersion": 1,
  "slug": "google-chat",
  "name": "Google Chat",
  "description": "搜索和读取 Google Chat 对话并发送消息。",
  "categories": [
    "communication",
    "productivity"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/google-chat.svg"
  },
  "urlPatterns": [
    "https://chatmcp.googleapis.com/*",
    "https://chat.google.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/chat/api/reference/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "chat.read",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "搜索对话并读取消息。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth，以只读方式访问 Google Chat。",
      "defaults": {
        "serverUrl": "https://chatmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/chat.spaces.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly"
        ]
      },
      "guidanceMd": "连接 Google Chat，以搜索对话和读取消息。暂不支持按已读或未读筛选，也不支持列出成员。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "搜索对话并读取消息。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端，以只读方式访问 Google Chat。",
      "defaults": {
        "serverUrl": "https://chatmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/chat.spaces.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Chat API 和 Chat MCP API，配置 Chat 应用，然后登记 Alice 的回调地址。暂不支持按已读或未读筛选，也不支持列出成员。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "必须在 Cloud 项目中配置 Google Chat 应用。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "paperclip-write",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "chat.write",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和发送",
        "description": "读取 Chat 对话并发送消息。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 读取 Google Chat 并发送消息。",
      "defaults": {
        "serverUrl": "https://chatmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/chat.spaces.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly",
          "https://www.googleapis.com/auth/chat.messages.create"
        ]
      },
      "guidanceMd": "连接 Google Chat，以读取对话并发送经过批准的消息。暂不支持按已读或未读筛选，也不支持列出成员。",
      "warnings": [
        "发送消息需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "customer-write-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和发送",
        "description": "读取 Chat 对话并发送消息。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端读取 Google Chat 并发送消息。",
      "defaults": {
        "serverUrl": "https://chatmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/chat.spaces.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly",
          "https://www.googleapis.com/auth/chat.messages.create"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Chat API 和 Chat MCP API，配置 Chat 应用，然后登记 Alice 的回调地址。暂不支持按已读或未读筛选，也不支持列出成员。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "发送消息需要批准。",
        "必须在 Cloud 项目中配置 Google Chat 应用。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    }
  ]
}
