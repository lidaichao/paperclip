{
  "schemaVersion": 1,
  "slug": "cloudflare",
  "name": "Cloudflare",
  "description": "连接 Cloudflare 官方托管的 MCP 服务器。",
  "categories": [
    "developer"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/cloudflare.svg"
  },
  "urlPatterns": [
    "https://mcp.cloudflare.com/*"
  ],
  "docsUrl": "https://developers.cloudflare.com/agents/model-context-protocol/cloudflare/servers-for-cloudflare/",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录官方托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://mcp.cloudflare.com/mcp"
      },
      "guidanceMd": "在浏览器中连接 Cloudflare。需要一个有权访问待连接资源的 Cloudflare 账户。",
      "riskTier": "S3",
      "label": "使用 Cloudflare 登录",
      "consoleLinks": {
        "docs": "https://developers.cloudflare.com/agents/model-context-protocol/cloudflare/servers-for-cloudflare/"
      },
      "warnings": [
        "需要一个有权访问待连接资源的 Cloudflare 账户。"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用客户自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://mcp.cloudflare.com/mcp"
      },
      "guidanceMd": "使用客户自行创建的 Cloudflare 密钥。需要一个有权访问待连接资源的 Cloudflare 账户。",
      "riskTier": "S3",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Cloudflare API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "粘贴你的 Cloudflare API 令牌",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://developers.cloudflare.com/agents/model-context-protocol/cloudflare/servers-for-cloudflare/",
        "docs": "https://developers.cloudflare.com/agents/model-context-protocol/cloudflare/servers-for-cloudflare/"
      },
      "warnings": [
        "需要一个有权访问待连接资源的 Cloudflare 账户。"
      ]
    }
  ]
}
