      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "让成员在 Microsoft Teams 中发起工作，并与一个 Alice 智能体持续协作。",
      "credentialFields": [
        {
          "key": "clientId",
          "label": "应用 / 客户端 ID",
          "type": "text",
          "required": true,
          "placeholder": "00000000-0000-0000-0000-000000000000",
          "secret": false
        },
        {
          "key": "tenantId",
          "label": "目录 / 租户 ID",
          "type": "text",
          "required": true,
          "placeholder": "00000000-0000-0000-0000-000000000000",
          "secret": false
        },
        {
          "key": "clientSecret",
          "label": "客户端密钥",
          "type": "password",
          "required": true,
          "placeholder": "粘贴客户端密钥值",
          "secret": true
        }
      ],
      "guidanceMd": "请使用能够注册 Entra 应用、创建单租户 Azure 机器人并上传或安装 Teams 应用的 Microsoft 365 工作或学校组织。teams.live.com 的个人或免费 Teams 账户无法完成此设置。请启用 personal、team 和 groupChat 机器人范围，以及 ChannelMessage.Read.Group 和 ChatMessage.Read.Chat 资源特定（resource-specific）应用权限。这些 RSC 授权允许已安装的应用在没有 @提及 的情况下接收团队或群聊中的每条消息，因此必须向安装者说明此访问范围。安装到一个团队即可覆盖其标准频道；私有和共享频道需要单独安装，本版本暂不支持。",
      "consoleLinks": {
        "register": "https://dev.teams.microsoft.com/apps",
        "docs": "https://learn.microsoft.com/en-us/microsoftteams/platform/bots/how-to/create-a-bot-for-teams"
      },
      "riskTier": "S3",
      "requiredResourceFilters": [
        "team",
        "channel",
        "chat"
      ]
    }
