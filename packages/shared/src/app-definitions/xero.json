{
  "schemaVersion": 1,
  "slug": "xero",
  "name": "Xero",
  "description": "连接 Xero 官方托管的 MCP 服务器。",
  "categories": [
    "commerce"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/xero.svg"
  },
  "urlPatterns": [
    "https://mcp.xero.com/*"
  ],
  "docsUrl": "https://developer.xero.com/ai",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-own-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "在 Xero 中注册 OAuth 应用，然后输入客户端 ID 和密钥。",
      "defaults": {
        "serverUrl": "https://mcp.xero.com/mcp",
        "scopesHint": [
          "openid",
          "profile",
          "email",
          "offline_access",
          "accounting.settings",
          "accounting.invoices.read",
          "accounting.reports.aged.read",
          "accounting.reports.balancesheet.read",
          "accounting.reports.profitandloss.read"
        ]
      },
      "guidanceMd": "在浏览器中连接 Xero。连接前请创建 Xero OAuth 应用，并确认适用的 AI 及数据使用条款。",
      "riskTier": "S4",
      "label": "使用自己的 OAuth 应用",
      "consoleLinks": {
        "register": "https://developer.xero.com/ai",
        "docs": "https://developer.xero.com/ai"
      },
      "warnings": [
        "连接前请创建 Xero OAuth 应用，并确认适用的 AI 及数据使用条款。"
      ]
    }
  ]
}
