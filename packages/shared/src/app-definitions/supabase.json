{
  "schemaVersion": 1,
  "slug": "supabase",
  "name": "Supabase",
  "description": "连接 Supabase 官方托管的 MCP 服务器。",
  "categories": [
    "data"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/supabase.svg"
  },
  "urlPatterns": [
    "https://mcp.supabase.com/*"
  ],
  "docsUrl": "https://supabase.com/docs/guides/ai-tools/mcp",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录服务商托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://mcp.supabase.com/mcp"
      },
      "guidanceMd": "在浏览器中连接 Supabase，并把连接范围限制到一个开发项目。写入工具默认启用，且始终受 Alice 操作策略治理。",
      "riskTier": "S4",
      "label": "使用 Supabase 登录",
      "consoleLinks": {
        "docs": "https://supabase.com/docs/guides/ai-tools/mcp"
      },
      "warnings": [
        "需要 Supabase 账户；请使用开发项目，并在连接生产数据前审查写入操作。",
        "除非已阅读 Supabase 的 MCP 安全指南，否则不要连接生产数据。"
      ],
      "tenantFields": [
        {
          "key": "projectRef",
          "label": "项目引用",
          "type": "text",
          "required": true,
          "placeholder": "abcdefghijklmnopqrst",
          "helperMd": "把连接范围限制到一个开发项目。",
          "transport": {
            "location": "query",
            "name": "project_ref"
          }
        },
        {
          "key": "readOnly",
          "label": "只读模式",
          "type": "checkbox",
          "defaultValue": false,
          "helperMd": "启用后，阻止此连接修改数据库。",
          "transport": {
            "location": "query",
            "name": "read_only",
            "format": "boolean"
          }
        },
        {
          "key": "features",
          "label": "功能组",
          "type": "textarea",
          "advanced": true,
          "placeholder": "database,docs",
          "helperMd": "可选，使用逗号分隔功能组。",
          "transport": {
            "location": "query",
            "name": "features",
            "format": "csv"
          }
        }
      ],
      "requiredResourceFilters": [
        "project"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://mcp.supabase.com/mcp"
      },
      "guidanceMd": "使用自行创建的 Supabase 密钥，并把范围限制到一个开发项目。写入工具默认启用，且始终受 Alice 操作策略治理。",
      "riskTier": "S4",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Supabase API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "sbp_...",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://supabase.com/docs/guides/ai-tools/mcp",
        "docs": "https://supabase.com/docs/guides/ai-tools/mcp"
      },
      "warnings": [
        "需要 Supabase 账户；请使用开发项目，并在连接生产数据前审查写入操作。",
        "除非已阅读 Supabase 的 MCP 安全指南，否则不要连接生产数据。"
      ],
      "tenantFields": [
        {
          "key": "projectRef",
          "label": "项目引用",
          "type": "text",
          "required": true,
          "placeholder": "abcdefghijklmnopqrst",
          "helperMd": "把连接范围限制到一个开发项目。",
          "transport": {
            "location": "query",
            "name": "project_ref"
          }
        },
        {
          "key": "readOnly",
          "label": "只读模式",
          "type": "checkbox",
          "defaultValue": false,
          "helperMd": "启用后，阻止此连接修改数据库。",
          "transport": {
            "location": "query",
            "name": "read_only",
            "format": "boolean"
          }
        },
        {
          "key": "features",
          "label": "功能组",
          "type": "textarea",
          "advanced": true,
          "placeholder": "database,docs",
          "helperMd": "可选，使用逗号分隔功能组。",
          "transport": {
            "location": "query",
            "name": "features",
            "format": "csv"
          }
        }
      ],
      "requiredResourceFilters": [
        "project"
      ]
    }
  ]
}
