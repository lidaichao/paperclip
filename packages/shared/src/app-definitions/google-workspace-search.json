{
  "schemaVersion": 1,
  "slug": "google-workspace-search",
  "name": "Google Workspace Search",
  "description": "通过一个只读的 Google Workspace 搜索工具检索 Gmail、云端硬盘、日历和 Chat。",
  "categories": [
    "data",
    "productivity"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/google-workspace-search.svg"
  },
  "urlPatterns": [
    "https://workspacemcp.googleapis.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/guides/universal-search-mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "workspace-search.read",
      "capabilityProfile": {
        "key": "read",
        "label": "搜索 Workspace",
        "description": "以只读方式搜索 Gmail、云端硬盘、日历和 Chat。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 进行跨产品 Workspace 搜索。",
      "defaults": {
        "serverUrl": "https://workspacemcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/calendar.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly"
        ]
      },
      "guidanceMd": "连接 Google Workspace 搜索，使用一个只读工具同时检索 Gmail、云端硬盘、日历和 Chat。",
      "warnings": [
        "这会申请对四类受支持搜索数据的读取权限。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "搜索 Workspace",
        "description": "以只读方式搜索 Gmail、云端硬盘、日历和 Chat。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端进行跨产品 Workspace 搜索。",
      "defaults": {
        "serverUrl": "https://workspacemcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/calendar.readonly",
          "https://www.googleapis.com/auth/chat.messages.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Gmail、Drive、Calendar、Chat 和 Workspace MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/universal-search-mcp"
      },
      "warnings": [
        "这会申请对四类受支持搜索数据的读取权限。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    }
  ]
}
