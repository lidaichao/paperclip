{
  "schemaVersion": 1,
  "slug": "sanity",
  "name": "Sanity",
  "description": "连接 Sanity 官方托管的 MCP 服务器。",
  "categories": [
    "content"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/sanity.svg",
    "darkLogoUrl": "/brands/apps/sanity-dark.svg"
  },
  "urlPatterns": [
    "https://mcp.sanity.io/*"
  ],
  "docsUrl": "https://www.sanity.io/docs/ai/mcp-server",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录官方托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://mcp.sanity.io"
      },
      "guidanceMd": "在浏览器中连接 Sanity。需要一个有权访问相关项目和数据集的 Sanity 账户。",
      "riskTier": "S3",
      "label": "使用 Sanity 登录",
      "consoleLinks": {
        "docs": "https://www.sanity.io/docs/ai/mcp-server"
      },
      "warnings": [
        "需要一个有权访问相关项目和数据集的 Sanity 账户。"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用客户自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://mcp.sanity.io"
      },
      "guidanceMd": "使用客户自行创建的 Sanity 密钥。需要一个有权访问相关项目和数据集的 Sanity 账户。",
      "riskTier": "S3",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Sanity API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "sk...",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://www.sanity.io/docs/ai/mcp-server",
        "docs": "https://www.sanity.io/docs/ai/mcp-server"
      },
      "warnings": [
        "需要一个有权访问相关项目和数据集的 Sanity 账户。"
      ]
    }
  ]
}
