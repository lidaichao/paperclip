{
  "schemaVersion": 1,
  "slug": "stripe",
  "name": "Stripe",
  "description": "连接 Stripe 官方托管的 MCP 服务器。",
  "categories": [
    "commerce"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/stripe.svg"
  },
  "urlPatterns": [
    "https://mcp.stripe.com/*"
  ],
  "docsUrl": "https://docs.stripe.com/mcp",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录服务商托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://mcp.stripe.com"
      },
      "guidanceMd": "在浏览器中连接 Stripe。需要 Stripe 账户；服务器处于公开预览阶段，付款操作需要明确批准。",
      "riskTier": "S4",
      "label": "使用 Stripe 登录",
      "consoleLinks": {
        "docs": "https://docs.stripe.com/mcp"
      },
      "warnings": [
        "需要 Stripe 账户；服务器处于公开预览阶段，付款操作需要明确批准。",
        "财务或破坏性操作必须在执行前获得明确批准。"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://mcp.stripe.com"
      },
      "guidanceMd": "使用自行创建的 Stripe 密钥。需要 Stripe 账户；服务器处于公开预览阶段，付款操作需要明确批准。",
      "riskTier": "S4",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Stripe API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "sk_...",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://docs.stripe.com/mcp",
        "docs": "https://docs.stripe.com/mcp"
      },
      "warnings": [
        "需要 Stripe 账户；服务器处于公开预览阶段，付款操作需要明确批准。",
        "财务或破坏性操作必须在执行前获得明确批准。"
      ]
    }
  ]
}
