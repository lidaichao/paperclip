{
  "schemaVersion": 1,
  "slug": "bitly",
  "name": "Bitly",
  "description": "连接 Bitly 官方托管的 MCP 服务器。",
  "categories": [
    "analytics"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/bitly.svg"
  },
  "urlPatterns": [
    "https://api-ssl.bitly.com/*"
  ],
  "docsUrl": "https://dev.bitly.com/bitly-mcp/overview/quickstart/",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录官方托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://api-ssl.bitly.com/v4/mcp"
      },
      "guidanceMd": "在浏览器中连接 Bitly。需要可通过浏览器授权或 API 令牌访问的 Bitly 账户。",
      "riskTier": "S2",
      "label": "使用 Bitly 登录",
      "consoleLinks": {
        "docs": "https://dev.bitly.com/bitly-mcp/overview/quickstart/"
      },
      "warnings": [
        "需要可通过浏览器授权或 API 令牌访问的 Bitly 账户。"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用客户自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://api-ssl.bitly.com/v4/mcp"
      },
      "guidanceMd": "使用客户自行创建的 Bitly 密钥。需要可通过浏览器授权或 API 令牌访问的 Bitly 账户。",
      "riskTier": "S2",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Bitly API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "粘贴你的 Bitly API 令牌",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://dev.bitly.com/bitly-mcp/overview/quickstart/",
        "docs": "https://dev.bitly.com/bitly-mcp/overview/quickstart/"
      },
      "warnings": [
        "需要可通过浏览器授权或 API 令牌访问的 Bitly 账户。"
      ]
    }
  ]
}
