{
  "schemaVersion": 1,
  "slug": "google-sheets",
  "name": "Google Sheets",
  "description": "读取和更新 Google 表格。",
  "categories": [
    "data",
    "productivity"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/google-sheets.svg"
  },
  "urlPatterns": [
    "https://sheetsmcp.googleapis.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://sheets.google.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/sheets/api/reference/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "sheets.read",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取表格数据和结构。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth，以只读方式访问 Google 表格。",
      "defaults": {
        "serverUrl": "https://sheetsmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/spreadsheets.readonly"
        ]
      },
      "guidanceMd": "连接 Google 表格，以读取电子表格。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取表格数据和结构。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端，以只读方式访问 Google 表格。",
      "defaults": {
        "serverUrl": "https://sheetsmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/spreadsheets.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Drive API、Sheets API 和 Sheets MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "paperclip-write",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "sheets.write",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和编辑",
        "description": "读取和更新表格数据、公式及行列尺寸。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 读取和更新 Google 表格。",
      "defaults": {
        "serverUrl": "https://sheetsmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/spreadsheets"
        ]
      },
      "guidanceMd": "连接 Google 表格，以读取和更新电子表格。",
      "warnings": [
        "更新电子表格需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "customer-write-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和编辑",
        "description": "读取和更新表格数据、公式及行列尺寸。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端读取和更新 Google 表格。",
      "defaults": {
        "serverUrl": "https://sheetsmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/spreadsheets"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Drive API、Sheets API 和 Sheets MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "更新电子表格需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "local",
      "label": "使用 Alice 机器人账户",
      "transport": "local_stdio",
      "auth": "none",
      "capabilityProfile": {
        "key": "robot",
        "label": "共享指定表格",
        "description": "仅向 Alice 机器人账户共享指定的电子表格。"
      },
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "把指定电子表格共享给 Alice 机器人账户，无需连接 Google 身份。",
      "defaults": {
        "templateKey": "paperclip.google-sheets"
      },
      "guidanceMd": "把每个电子表格共享给 Alice 机器人邮箱，然后粘贴表格链接。",
      "riskTier": "S3",
      "requiredResourceFilters": [
        "spreadsheet"
      ]
    }
  ]
}
