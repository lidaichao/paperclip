{
  "schemaVersion": 1,
  "slug": "razorpay",
  "name": "Razorpay",
  "description": "连接 Razorpay 官方托管的 MCP 服务器。",
  "categories": [
    "commerce"
  ],
  "featured": false,
  "branding": {
    "logoUrl": "/brands/apps/razorpay.svg",
    "darkLogoUrl": "/brands/apps/razorpay-dark.svg"
  },
  "urlPatterns": [
    "https://mcp.razorpay.com/*"
  ],
  "docsUrl": "https://razorpay.com/docs/mcp-server/oauth/",
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "dcr"
      ],
      "whenToUse": "通过浏览器登录官方托管的 MCP 服务器。",
      "defaults": {
        "serverUrl": "https://mcp.razorpay.com/mcp"
      },
      "guidanceMd": "在浏览器中连接 Razorpay。需要 Razorpay 账户；任何财务或破坏性操作都必须获得明确批准。",
      "riskTier": "S4",
      "label": "使用 Razorpay 登录",
      "consoleLinks": {
        "docs": "https://razorpay.com/docs/mcp-server/oauth/"
      },
      "warnings": [
        "需要 Razorpay 账户；任何财务或破坏性操作都必须获得明确批准。",
        "财务或破坏性操作必须在执行前获得明确批准。"
      ]
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用客户自有的受限密钥。",
      "defaults": {
        "serverUrl": "https://mcp.razorpay.com/mcp"
      },
      "guidanceMd": "使用客户自行创建的 Razorpay 密钥。需要 Razorpay 账户；任何财务或破坏性操作都必须获得明确批准。",
      "riskTier": "S4",
      "label": "使用 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Razorpay API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "粘贴经过 Base64 编码的密钥 ID 和密钥内容",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Basic "
      },
      "consoleLinks": {
        "keys": "https://razorpay.com/docs/mcp-server/oauth/",
        "docs": "https://razorpay.com/docs/mcp-server/oauth/"
      },
      "warnings": [
        "需要 Razorpay 账户；任何财务或破坏性操作都必须获得明确批准。",
        "财务或破坏性操作必须在执行前获得明确批准。"
      ]
    }
  ]
}
