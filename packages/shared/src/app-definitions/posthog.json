{
  "schemaVersion": 1,
  "slug": "posthog",
  "name": "PostHog",
  "description": "使用 PostHog 托管的 MCP 服务器分析产品使用情况、错误、功能开关和实验。",
  "categories": [
    "analytics"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/posthog.svg",
    "darkLogoUrl": "/brands/apps/posthog-dark.svg"
  },
  "urlPatterns": [
    "https://mcp.posthog.com/*"
  ],
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "customer",
        "dcr"
      ],
      "whenToUse": "在浏览器中登录 PostHog。推荐用于 PostHog 托管账户。",
      "defaults": {
        "serverUrl": "https://mcp.posthog.com/mcp"
      },
      "guidanceMd": "使用 PostHog 推荐的默认设置连接。固定项目、只读访问和目录筛选属于可选高级设置。",
      "riskTier": "S3",
      "tenantFields": [
        {
          "key": "projectId",
          "label": "固定到项目 ID",
          "type": "text",
          "advanced": true,
          "placeholder": "可选的数字项目 ID",
          "helperMd": "可选。把此连接固定到一个项目，并移除 PostHog 的项目切换工具。",
          "validation": {
            "pattern": "^[0-9]+$",
            "maxLength": 32
          },
          "transport": {
            "location": "header",
            "name": "x-posthog-project-id"
          }
        },
        {
          "key": "readOnly",
          "label": "只读模式",
          "type": "checkbox",
          "advanced": true,
          "defaultValue": false,
          "helperMd": "启用后，隐藏可能修改 PostHog 数据的工具。",
          "transport": {
            "location": "query",
            "name": "readonly",
            "format": "boolean",
            "omitFalse": true
          }
        },
        {
          "key": "features",
          "label": "功能组",
          "type": "textarea",
          "advanced": true,
          "placeholder": "可选，使用逗号分隔功能组",
          "helperMd": "留空会开放所有功能组；也可以输入逗号分隔的列表来限制访问范围。",
          "validation": {
            "maxLength": 500
          },
          "transport": {
            "location": "query",
            "name": "features",
            "format": "csv"
          }
        },
        {
          "key": "tools",
          "label": "单项工具",
          "type": "textarea",
          "advanced": true,
          "placeholder": "可选，使用逗号分隔工具名称",
          "helperMd": "留空会开放所有工具。这里填写的准确名称会与功能组设置合并生效。",
          "validation": {
            "maxLength": 2000
          },
          "transport": {
            "location": "query",
            "name": "tools",
            "format": "csv"
          }
        },
        {
          "key": "mode",
          "label": "工具响应模式",
          "type": "select",
          "hidden": true,
          "required": true,
          "placeholder": "单项工具",
          "defaultValue": "tools",
          "options": [
            {
              "value": "tools",
              "label": "单项工具"
            }
          ],
          "helperMd": "Alice 使用单项工具，以便治理每个操作。在嵌套执行纳入治理前，CLI 模式仍不可用。",
          "transport": {
            "location": "query",
            "name": "mode"
          }
        }
      ],
      "label": "使用 PostHog 登录",
      "consoleLinks": {
        "docs": "https://posthog.com/docs/model-context-protocol"
      },
      "credentialSources": {
        "vercelConnect": {
          "services": [
            "posthog",
            "mcp.posthog.com/mcp"
          ],
          "principalModes": [
            "user"
          ],
          "scopes": [
            "*"
          ],
          "header": {
            "name": "Authorization",
            "prefix": "Bearer "
          }
        }
      }
    },
    {
      "key": "mcp-api-key",
      "transport": "mcp_remote",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "不适合通过浏览器登录时，使用 PostHog 个人 API 密钥。",
      "defaults": {
        "serverUrl": "https://mcp.posthog.com/mcp"
      },
      "guidanceMd": "使用 PostHog 推荐的默认设置连接。固定项目、只读访问和目录筛选属于可选高级设置。",
      "riskTier": "S3",
      "tenantFields": [
        {
          "key": "projectId",
          "label": "固定到项目 ID",
          "type": "text",
          "advanced": true,
          "placeholder": "可选的数字项目 ID",
          "helperMd": "可选。把此连接固定到一个项目，并移除 PostHog 的项目切换工具。",
          "validation": {
            "pattern": "^[0-9]+$",
            "maxLength": 32
          },
          "transport": {
            "location": "header",
            "name": "x-posthog-project-id"
          }
        },
        {
          "key": "readOnly",
          "label": "只读模式",
          "type": "checkbox",
          "advanced": true,
          "defaultValue": false,
          "helperMd": "启用后，隐藏可能修改 PostHog 数据的工具。",
          "transport": {
            "location": "query",
            "name": "readonly",
            "format": "boolean",
            "omitFalse": true
          }
        },
        {
          "key": "features",
          "label": "功能组",
          "type": "textarea",
          "advanced": true,
          "placeholder": "可选，使用逗号分隔功能组",
          "helperMd": "留空会开放所有功能组；也可以输入逗号分隔的列表来限制访问范围。",
          "validation": {
            "maxLength": 500
          },
          "transport": {
            "location": "query",
            "name": "features",
            "format": "csv"
          }
        },
        {
          "key": "tools",
          "label": "单项工具",
          "type": "textarea",
          "advanced": true,
          "placeholder": "可选，使用逗号分隔工具名称",
          "helperMd": "留空会开放所有工具。这里填写的准确名称会与功能组设置合并生效。",
          "validation": {
            "maxLength": 2000
          },
          "transport": {
            "location": "query",
            "name": "tools",
            "format": "csv"
          }
        },
        {
          "key": "mode",
          "label": "工具响应模式",
          "type": "select",
          "hidden": true,
          "required": true,
          "placeholder": "单项工具",
          "defaultValue": "tools",
          "options": [
            {
              "value": "tools",
              "label": "单项工具"
            }
          ],
          "helperMd": "Alice 使用单项工具，以便治理每个操作。在嵌套执行纳入治理前，CLI 模式仍不可用。",
          "transport": {
            "location": "query",
            "name": "mode"
          }
        }
      ],
      "label": "使用个人 API 密钥",
      "credentialFields": [
        {
          "key": "authorization",
          "label": "PostHog 个人 API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "phx_...",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "consoleLinks": {
        "keys": "https://posthog.com/docs/model-context-protocol/faq",
        "docs": "https://posthog.com/docs/model-context-protocol/faq"
      },
      "credentialSources": {
        "vercelConnect": {
          "services": [
            "posthog",
            "mcp.posthog.com/mcp"
          ],
          "principalModes": [
            "app"
          ],
          "scopes": [
            "*"
          ],
          "header": {
            "name": "Authorization",
            "prefix": "Bearer "
          }
        }
      }
    }
  ],
  "docsUrl": "https://posthog.com/docs/model-context-protocol",
  "redirectConstraints": "https-or-loopback-http"
}
