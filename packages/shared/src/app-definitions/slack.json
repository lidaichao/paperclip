{
  "schemaVersion": 1,
  "slug": "slack",
  "name": "Slack",
  "description": "为智能体提供 Slack 工具，或让成员通过 Slack 发起 Alice 工作并持续协作。",
  "categories": [
    "communication"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/slack.svg"
  },
  "urlPatterns": [
    "https://mcp.slack.com/*",
    "https://app.slack.com/client/*"
  ],
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用服务商托管的连接，以最快速度完成设置。",
      "defaults": {
        "serverUrl": "https://mcp.slack.com/mcp",
        "authorizationEndpoint": "https://slack.com/oauth/v2/authorize",
        "tokenEndpoint": "https://slack.com/api/oauth.v2.access",
        "scopesHint": [
          "channels:read",
          "chat:write",
          "search:read"
        ]
      },
      "guidanceMd": "连接 Slack 工作区，并仅授权智能体需要使用的频道。",
      "riskTier": "S3",
      "label": "将此连接用作智能体工具",
      "purpose": "tool",
      "requiredResourceFilters": [
        "workspace",
        "channel"
      ]
    },
    {
      "key": "chat-agent",
      "label": "与智能体对话",
      "purpose": "channel",
      "provider": "slack",
      "transport": "chat_sdk",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "让成员在 Slack 中发起工作，并与一个 Alice 智能体持续协作。",
      "credentialFields": [
        {
          "key": "botToken",
          "label": "机器人用户 OAuth 令牌",
          "type": "password",
          "required": true,
          "placeholder": "xoxb-...",
          "secret": true
        },
        {
          "key": "signingSecret",
          "label": "签名密钥",
          "type": "password",
          "required": true,
          "placeholder": "粘贴 Slack 应用签名密钥",
          "secret": true
        }
      ],
      "guidanceMd": "为此智能体创建并安装一个 Slack 应用。Alice 会接收经过验证的 Events API 请求和交互回调，通过表情回应确认，在私信中回复，并为每个首次提及智能体的频道讨论串创建一个 Alice 任务。",
      "consoleLinks": {
        "register": "https://api.slack.com/apps",
        "docs": "https://api.slack.com/start/quickstart"
      },
      "riskTier": "S3",
      "requiredResourceFilters": [
        "workspace",
        "channel"
      ]
    }
  ]
}
