{
  "schemaVersion": 1,
  "slug": "notion",
  "name": "Notion",
  "description": "读取和更新 Notion 工作区中的页面。",
  "categories": [
    "content"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/notion.svg"
  },
  "urlPatterns": [
    "https://mcp.notion.com/*"
  ],
  "methods": [
    {
      "key": "mcp-oauth",
      "transport": "mcp_remote",
      "auth": "oauth",
      "ownershipModes": [
        "customer",
        "dcr"
      ],
      "whenToUse": "使用服务商托管的连接，以最快速度完成设置。",
      "defaults": {
        "serverUrl": "https://mcp.notion.com/mcp"
      },
      "guidanceMd": "连接 Notion 工作区内容，并仅共享智能体需要使用的页面和数据库。",
      "riskTier": "S3",
      "requiredResourceFilters": [
        "workspace",
        "page",
        "database"
      ],
      "credentialSources": {
        "vercelConnect": {
          "services": [
            "notion"
          ],
          "principalModes": [
            "user"
          ],
          "scopes": [
            "*"
          ],
          "header": {
            "name": "Authorization",
            "prefix": "Bearer "
          }
        }
      }
    }
  ],
  "redirectConstraints": "https-or-loopback-http",
  "docsUrl": "https://developers.notion.com/guides/mcp/build-mcp-client"
}
