{
  "schemaVersion": 1,
  "slug": "openrouter",
  "name": "OpenRouter",
  "description": "为智能体连接 OpenRouter 账户。",
  "categories": [
    "ai"
  ],
  "branding": {
    "logoUrl": "/brands/apps/openrouter.svg",
    "darkLogoUrl": "/brands/apps/openrouter-dark.svg"
  },
  "urlPatterns": [
    "https://openrouter.ai/api/*"
  ],
  "methods": [
    {
      "key": "ai-api_key",
      "label": "OpenRouter API 密钥",
      "purpose": "ai",
      "transport": "runtime_auth",
      "auth": "api_key",
      "ai": {
        "provider": "openrouter",
        "method": "api_key"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用此账户验证智能体身份。",
      "guidanceMd": "使用个人账户，或公司明确授权共享的账户。",
      "riskTier": "S3",
      "credentialFields": [
        {
          "key": "apiKey",
          "label": "API 密钥",
          "type": "password",
          "required": true,
          "placeholder": "输入 API 密钥",
          "secret": true
        }
      ],
      "keyPlacement": {
        "location": "env",
        "name": "OPENROUTER_API_KEY"
      }
    }
  ]
}
