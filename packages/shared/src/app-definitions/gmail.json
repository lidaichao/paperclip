{
  "schemaVersion": 1,
  "slug": "gmail",
  "name": "Gmail",
  "description": "搜索和读取 Gmail 邮件并创建草稿，不启用邮件发送。",
  "categories": [
    "communication",
    "productivity"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/gmail.svg"
  },
  "urlPatterns": [
    "https://gmailmcp.googleapis.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/gmail/api/reference/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "gmail.read",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "搜索并读取邮件、会话、草稿和标签。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 Google OAuth，以只读方式访问 Gmail。",
      "defaults": {
        "serverUrl": "https://gmailmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly"
        ]
      },
      "guidanceMd": "以只读权限连接 Gmail。不启用发送、删除、移动邮件和修改标签功能。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "搜索并读取邮件、会话、草稿和标签。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 Google OAuth 客户端，以只读方式访问 Gmail。",
      "defaults": {
        "serverUrl": "https://gmailmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "在 Google Cloud 项目中启用 Gmail API 和 Gmail MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "paperclip-draft",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "gmail.draft",
      "capabilityProfile": {
        "key": "draft",
        "label": "读取并创建草稿",
        "description": "读取 Gmail，并创建可在 Gmail 中审阅的草稿。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 Google OAuth 读取 Gmail 并创建草稿。",
      "defaults": {
        "serverUrl": "https://gmailmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose"
        ]
      },
      "guidanceMd": "连接 Gmail，以搜索和读取邮件并创建草稿。邮件发送功能永久禁用。",
      "warnings": [
        "创建草稿需要批准。未启用邮件发送功能。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "customer-draft-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "draft",
        "label": "读取并创建草稿",
        "description": "读取 Gmail，并创建可在 Gmail 中审阅的草稿。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 Google OAuth 客户端读取 Gmail 并创建草稿。",
      "defaults": {
        "serverUrl": "https://gmailmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "在 Google Cloud 项目中启用 Gmail API 和 Gmail MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "创建草稿需要批准。未启用邮件发送功能。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    }
  ]
}
