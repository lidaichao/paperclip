{
  "schemaVersion": 1,
  "slug": "google-calendar",
  "name": "Google Calendar",
  "description": "读取日历并管理 Google 日历事件。",
  "categories": [
    "productivity"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/google-calendar.svg"
  },
  "urlPatterns": [
    "https://calendarmcp.googleapis.com/*",
    "https://calendar.google.com/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/calendar/api/reference/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "calendar.read",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取日历、事件和空闲状态。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth，以只读方式访问日历。",
      "defaults": {
        "serverUrl": "https://calendarmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly"
        ]
      },
      "guidanceMd": "连接 Google 日历，以读取日程和空闲状态。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取日历、事件和空闲状态。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端，以只读方式访问日历。",
      "defaults": {
        "serverUrl": "https://calendarmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Calendar API 和 Calendar MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "paperclip-write",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "calendar.write",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和管理",
        "description": "创建、更新、响应和删除事件。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 读取和管理日历事件。",
      "defaults": {
        "serverUrl": "https://calendarmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events"
        ]
      },
      "guidanceMd": "连接 Google 日历，以读取和管理事件。",
      "warnings": [
        "所有事件变更都需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "customer-write-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和管理",
        "description": "创建、更新、响应和删除事件。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端读取和管理日历事件。",
      "defaults": {
        "serverUrl": "https://calendarmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Calendar API 和 Calendar MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "所有事件变更都需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    }
  ]
}
