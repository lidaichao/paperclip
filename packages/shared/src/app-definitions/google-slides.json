{
  "schemaVersion": 1,
  "slug": "google-slides",
  "name": "Google Slides",
  "description": "读取和更新 Google 幻灯片演示文稿。",
  "categories": [
    "content",
    "productivity"
  ],
  "featured": true,
  "branding": {
    "logoUrl": "/brands/apps/google-slides.svg"
  },
  "urlPatterns": [
    "https://slidesmcp.googleapis.com/*",
    "https://docs.google.com/presentation/*"
  ],
  "docsUrl": "https://developers.google.com/workspace/slides/api/reference/mcp",
  "setupPrerequisite": {
    "title": "需要 Google 开发者预览计划权限",
    "description": "Google 必须登记用于授权 Alice 的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目。登记仅对指定邮箱和项目生效，不会为其他 Alice 用户开放权限。",
    "steps": [
      "使用准备登录的 Workspace 邮箱，以及拥有 OAuth 客户端的 Google Cloud 项目提交申请。",
      "等待 Google 群组通知和最终项目登记邮件，通常需要几天。",
      "连接前，通过 Google 成员申请表添加所有额外测试邮箱或 Cloud 项目。"
    ],
    "actionLabel": "申请或确认开发者预览计划资格",
    "actionUrl": "https://developers.google.com/workspace/preview"
  },
  "redirectConstraints": "https-or-loopback-http",
  "methods": [
    {
      "key": "paperclip-read",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "slides.read",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取演示文稿的幻灯片和内容。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth，以只读方式访问 Google 幻灯片。",
      "defaults": {
        "serverUrl": "https://slidesmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/presentations.readonly"
        ]
      },
      "guidanceMd": "连接 Google 幻灯片，以读取演示文稿。",
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "customer-read-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "read",
        "label": "只读",
        "description": "读取演示文稿的幻灯片和内容。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端，以只读方式访问 Google 幻灯片。",
      "defaults": {
        "serverUrl": "https://slidesmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/presentations.readonly"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Drive API、Slides API 和 Slides MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S3"
    },
    {
      "key": "paperclip-write",
      "label": "连接 Alice",
      "transport": "mcp_remote",
      "auth": "oauth",
      "oauthStrategy": "paperclip_cloud_connector",
      "connectorProfile": "slides.write",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和编辑",
        "description": "读取和更新演示文稿。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "platform_shared"
      ],
      "whenToUse": "使用 Alice 管理的 OAuth 读取和更新 Google 幻灯片。",
      "defaults": {
        "serverUrl": "https://slidesmcp.googleapis.com/mcp/v1",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/presentations"
        ]
      },
      "guidanceMd": "连接 Google 幻灯片，以读取和更新演示文稿。",
      "warnings": [
        "更新演示文稿需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    },
    {
      "key": "customer-write-oauth",
      "label": "使用自己的 Google OAuth 应用",
      "transport": "mcp_remote",
      "auth": "oauth",
      "capabilityProfile": {
        "key": "write",
        "label": "读取和编辑",
        "description": "读取和更新演示文稿。"
      },
      "grantKinds": [
        "user",
        "organization"
      ],
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "使用自有 OAuth 客户端读取和更新 Google 幻灯片。",
      "defaults": {
        "serverUrl": "https://slidesmcp.googleapis.com/mcp/v1",
        "authorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenEndpoint": "https://oauth2.googleapis.com/token",
        "metadataUrl": "https://accounts.google.com/.well-known/openid-configuration",
        "scopesHint": [
          "https://www.googleapis.com/auth/drive.readonly",
          "https://www.googleapis.com/auth/drive.file",
          "https://www.googleapis.com/auth/presentations"
        ],
        "oauthAuthorizationParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "guidanceMd": "启用 Drive API、Slides API 和 Slides MCP API，然后登记 Alice 的回调地址。",
      "consoleLinks": {
        "register": "https://console.cloud.google.com/auth/clients",
        "docs": "https://developers.google.com/workspace/guides/configure-mcp-servers"
      },
      "warnings": [
        "更新演示文稿需要批准。",
        "Google Workspace MCP 服务器仍处于开发者预览阶段。"
      ],
      "riskTier": "S4"
    }
  ]
}
